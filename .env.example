# ─────────────────────────────────────────────────────────────
#  Copiá este archivo como .env y completá los valores.
#  En Vercel, cargá las mismas variables en
#  Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Cadena de conexión de Neon (Dashboard → Connect → copiá la URL "pooled").
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Clave secreta para firmar las sesiones. Poné algo largo y aleatorio (mín. 16 caracteres).
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Emails que entran como administradores (separados por coma).
ADMIN_EMAILS=tu-email@gmail.com

# URL pública del sitio (para los links de los mails). En local podés dejarla vacía.
SITE_URL=

# ── Envío de emails: completá UNA de las dos opciones ─────────
# Si no completás ninguna, en local el código aparece en pantalla y en la terminal.

# Opción A — Resend (recomendado con Vercel): https://resend.com
RESEND_API_KEY=
# Opción B — SMTP (Gmail con "contraseña de aplicación", Brevo, Zoho, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Remitente de los mails. Con Resend, el dominio tiene que estar verificado.
MAIL_FROM=Mostrador <hola@tudominio.com>
